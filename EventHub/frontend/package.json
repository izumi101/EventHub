{
  "name": "eventhub-frontend",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:types": "openapi-typescript ../backend/openapi.yaml -o src/app/api/openapi.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lucide-angular": "^1.0.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.14",
    "@angular/build": "^21.2.28",
    "@angular/cli": "^21.2.14",
    "@angular/compiler-cli": "^21.2.25",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/qrcode": "^1.5.6",
    "angular-eslint": "^21.4.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.1.0",
    "openapi-typescript": "7.13.0",
    "postcss": "^8.5.9",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.1",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@angular/build": {
      "undici": "^7.30.1"
    },
    "sockjs": {
      "uuid": "^11.1.1"
    }
  }
}
