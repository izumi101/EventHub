# Local development: `cp .env.example .env`, then `docker compose up --build`.
# docker-compose.yml itself defaults to production-safe values; this file
# switches on the developer conveniences. Never use these values on a server.

POSTGRES_DB=eventhub
POSTGRES_USER=eventhub_user
POSTGRES_PASSWORD=eventhub_password
POSTGRES_HOST_PORT=5433

DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
# Hosts/origins you open the app from (add your LAN IP to test on a phone,
# e.g. ,192.168.0.10 and ,https://192.168.0.10).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://localhost
FRONTEND_URL=http://localhost:4200

# Demo users (organizer/password123, attendee/password123). The admin password
# is printed in the backend log unless you set one here.
DJANGO_SEED_DATA=1
DJANGO_SEED_ADMIN_PASSWORD=
DJANGO_COLLECTSTATIC=0

# Payments: with STRIPE_MOCK_MODE=1 (DEBUG only) tickets are confirmed without
# charging anyone. Set real test keys and STRIPE_MOCK_MODE=0 to use Stripe.
STRIPE_MOCK_MODE=1
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email: leave empty in development — codes are printed in the backend log and,
# with DEBUG=1, shown in the sign-up form. Required when DJANGO_DEBUG=0.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=EventHub <no-reply@eventhub.local>

# Image: set to 0 for a slim backend without semantic search (no PyTorch).
INSTALL_SEMANTIC_SEARCH=1

# Background jobs run in the `worker` container. Set 1 only when running the
# backend without a worker (jobs then run right after each request).
JOBS_RUN_INLINE=0

# Monitoring stack (docker-compose.monitoring.yml)
GRAFANA_ADMIN_PASSWORD=
