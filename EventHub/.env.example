# Local development: `cp .env.example .env`, then `docker compose up --build`.
# docker-compose.yml itself defaults to production-safe values; this file
# switches on the developer conveniences. Never use these values on a server.

# Database roles (docs/DATABASE_ROLES.md). POSTGRES_USER owns the schema and
# runs the migrations. The backend and worker connect as POSTGRES_APP_USER
# (rows only, no DDL); reports and `manage.py run_sql_checks` use the
# SELECT-only POSTGRES_READONLY_USER. Both roles are created / updated, and
# their passwords reset from here, on every backend start. Leaving
# POSTGRES_APP_PASSWORD empty makes the app connect as the owner (old
# behaviour, with a warning). Demo values: change all three passwords on a
# server.
POSTGRES_DB=eventhub
POSTGRES_USER=eventhub_user
POSTGRES_PASSWORD=eventhub_password
POSTGRES_APP_USER=eventhub_app
POSTGRES_APP_PASSWORD=eventhub_app_dev_password
POSTGRES_READONLY_USER=eventhub_readonly
POSTGRES_READONLY_PASSWORD=eventhub_readonly_dev_password
POSTGRES_HOST_PORT=5433

DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
# Hosts/origins you open the app from (add your LAN IP to test on a phone,
# e.g. ,192.168.0.10 and ,https://192.168.0.10).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://localhost
FRONTEND_URL=http://localhost:4200

# Demo users (organizer/password123, attendee/password123). The admin password
# is printed in the backend log unless you set one here.
DJANGO_SEED_DATA=1
DJANGO_SEED_ADMIN_PASSWORD=
DJANGO_COLLECTSTATIC=0

# Payments (docs/adr/0001-payment-provider-layer.md). PAYMENT_PROVIDERS_ENABLED
# lists the providers that may take money; with DJANGO_DEBUG=0 every enabled
# provider must be fully configured. PAYMENTS_MOCK_MODE=1 (DEBUG only)
# confirms tickets without charging anyone; set it to 0 and add real test keys
# to use Stripe. STRIPE_MOCK_MODE is the deprecated name of PAYMENTS_MOCK_MODE
# and is only read while PAYMENTS_MOCK_MODE is empty.
PAYMENT_PROVIDERS_ENABLED=stripe,freedompay
PAYMENTS_MOCK_MODE=1
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Freedom Pay (KZT events, docs/payments/freedompay-protocol.md). These demo
# values talk to the fpay-emulator service (fake gateway, no real money); the
# emulator gets the same merchant id and secret. Tickets of KZT events are
# paid there (by card or QR code); every other currency keeps Stripe/mock.
# A real deployment: FREEDOMPAY_API_URL=https://api.freedompay.kz, the real
# merchant id and payment key, an https FREEDOMPAY_RESULT_URL the gateway can
# reach, FREEDOMPAY_TESTING_MODE=0 and FREEDOMPAY_DEMO_MODE=0.
FREEDOMPAY_API_URL=http://fpay-emulator:8080
FREEDOMPAY_MERCHANT_ID=12345
FREEDOMPAY_SECRET_KEY=demo-fpay-secret-change-me
FREEDOMPAY_RESULT_URL=http://backend:8000/api/v1/payments/callback/freedompay/
# pg_testing_mode=1: test transactions only.
FREEDOMPAY_TESTING_MODE=1
# Lets DJANGO_DEBUG=0 start with the emulator URL and demo keys (demo only).
FREEDOMPAY_DEMO_MODE=1
# Address of the emulator's payment page as the browser sees it (also what
# the QR code encodes). For paying with a phone: http://<laptop LAN IP>:18080
# and FPAY_EMULATOR_BIND=0.0.0.0 (publishes port 18080 on the LAN; set a
# FPAY_CONTROL_TOKEN then, it protects the emulator's /_emulator control API).
FPAY_PUBLIC_URL=http://localhost:18080
FPAY_EMULATOR_BIND=127.0.0.1
FPAY_CONTROL_TOKEN=

# Email: leave empty in development — codes are printed in the backend log and,
# with DEBUG=1, shown in the sign-up form. Required when DJANGO_DEBUG=0.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=EventHub <no-reply@eventhub.local>

# Image: set to 0 for a slim backend without semantic search (no PyTorch).
INSTALL_SEMANTIC_SEARCH=1

# Background jobs run in the `worker` container. Set 1 only when running the
# backend without a worker (jobs then run right after each request).
JOBS_RUN_INLINE=0

# Backend worker processes (gunicorn + uvicorn) per container.
WEB_CONCURRENCY=2

# Feature flags — self-hosted Unleash (docs/FEATURE_FLAGS.md). Without it every
# flag uses its default from backend/featureflags/registry.py. To run Unleash
# locally set COMPOSE_PROFILES=flags and UNLEASH_ENABLED=1, then open
# http://localhost:4242 (admin / UNLEASH_ADMIN_PASSWORD).
COMPOSE_PROFILES=
UNLEASH_ENABLED=0
UNLEASH_ENVIRONMENT=development
UNLEASH_HOST_PORT=4242
UNLEASH_DB_PASSWORD=unleash_dev_password
UNLEASH_ADMIN_PASSWORD=unleash-dev-admin-1
# Backend token "<project>:<environment>.<secret>"; created on Unleash's first
# start and used by the backend to poll. Never give it to the browser.
UNLEASH_BACKEND_API_TOKEN=*:development.dev-only-backend-token
# Admin token for scripting against the local Unleash API. Leave empty on a
# server (use a personal access token from the UI instead).
UNLEASH_ADMIN_API_TOKEN=*:*.dev-only-admin-token

# Monitoring stack (docker-compose.monitoring.yml)
GRAFANA_ADMIN_PASSWORD=
