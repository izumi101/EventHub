# EventHub production .env (docker-compose.yml + docker-compose.prod.yml).
#
# Do not copy this file by hand: run `scripts/prod-env.sh` ON THE SERVER. It
# writes EventHub/.env with fresh random secrets (mode 600) and asks for the
# values only the owner knows. This file documents every variable.
# docs/DEPLOY.md is the step-by-step guide.
#
# Legend: [generated] by prod-env.sh, [owner] you fill it in, [default] fine as is.

# ---- Public addresses ------------------------------------------------------
# [owner] Bare host names (no scheme, no port). First deploy uses sslip.io,
# which resolves <a-b-c-d>.sslip.io to the IP a.b.c.d.
SITE_DOMAIN=172-198-71-209.sslip.io
# [owner] Hosted payment page of the Freedom Pay emulator (QR codes open it).
PAY_DOMAIN=pay.172-198-71-209.sslip.io
# [owner, optional] Contact for the Let's Encrypt account (empty is allowed).
ACME_EMAIL=
# Local testing only: 1 = certificates from Caddy's internal CA (`tls internal`)
# instead of Let's Encrypt. MUST be empty on a server.
CADDY_LOCAL_CERTS=
# Local testing only: ":<port>" when Caddy's 443 is mapped to another host
# port (e.g. :38443). Empty on a server.
PUBLIC_URL_PORT=

# ---- Django ----------------------------------------------------------------
# [generated] 64 random characters.
DJANGO_SECRET_KEY=
# DJANGO_DEBUG, allowed hosts, CORS/CSRF origins, FRONTEND_URL, WebAuthn and
# secure cookies are derived from SITE_DOMAIN in docker-compose.prod.yml.

# ---- PostgreSQL roles (docs/DATABASE_ROLES.md) -----------------------------
POSTGRES_DB=eventhub
# Schema owner: runs migrate / setup_db_roles only.
POSTGRES_USER=eventhub_user
# [generated]
POSTGRES_PASSWORD=
# App role used by gunicorn and the worker (no DDL). Mandatory in production.
POSTGRES_APP_USER=eventhub_app
# [generated]
POSTGRES_APP_PASSWORD=
# SELECT-only role (reports, run_sql_checks).
POSTGRES_READONLY_USER=eventhub_readonly
# [generated]
POSTGRES_READONLY_PASSWORD=

# ---- Two-factor authentication (docs/SECURITY_2FA.md) ----------------------
# [generated] secrets.token_urlsafe(48); comma list for rotation.
MFA_ENCRYPTION_KEY=
MFA_REQUIRED_ROLES=organizer,staff,superuser
# Demo: email codes allowed for organizers. A real launch should use 0.
MFA_EMAIL_ALLOWED_FOR_REQUIRED_ROLES=1
MFA_STEP_UP_MAX_AGE_SECONDS=600

# ---- Payments: demo mode against the Freedom Pay emulator ------------------
PAYMENT_PROVIDERS_ENABLED=freedompay
FREEDOMPAY_API_URL=http://fpay-emulator:8080
# [generated] digits only (the emulator requires a numeric merchant id).
FREEDOMPAY_MERCHANT_ID=
# [generated] shared by the backend and the emulator.
FREEDOMPAY_SECRET_KEY=
FREEDOMPAY_RESULT_URL=http://backend:8000/api/v1/payments/callback/freedompay/
FREEDOMPAY_TESTING_MODE=1
# Allows the emulator with DJANGO_DEBUG=0. Set 0 only with a real acquirer.
FREEDOMPAY_DEMO_MODE=1
# [generated] protects the emulator's /_emulator control API (also blocked at Caddy).
FPAY_CONTROL_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Email (docs/NOTIFICATIONS.md) -----------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
# [owner] Gmail address and a 16-character app password (needs 2-Step
# Verification). Compose refuses to start while either is empty.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# [owner] Gmail rewrites From to the authenticated account; keep them equal.
DEFAULT_FROM_EMAIL=
NOTIFICATION_TIME_ZONE=Asia/Almaty
EVENT_DEFAULT_DURATION_HOURS=3

# ---- Demo data (scripts/prod-deploy.sh --seed-demo) ------------------------
# [owner] Password of the `admin` superuser created by the demo seed.
DJANGO_SEED_ADMIN_PASSWORD=
# [generated] Password of the demo `organizer` / `attendee` accounts (>= 12
# characters, never password123). Read it with: grep DEMO_PASSWORD .env
DJANGO_SEED_DEMO_PASSWORD=

# ---- Runtime ---------------------------------------------------------------
# 1 = semantic search (PyTorch, bigger image, ~+1 GB RAM); 0 = keyword search.
INSTALL_SEMANTIC_SEARCH=1
JOBS_RUN_INLINE=0
WEB_CONCURRENCY=2
DJANGO_THROTTLE_RATES=

# ---- Feature flags (optional `flags` profile, docs/FEATURE_FLAGS.md) -------
COMPOSE_PROFILES=
UNLEASH_ENABLED=0
UNLEASH_ENVIRONMENT=production
# [generated] (needed by compose even when the profile is off)
UNLEASH_DB_PASSWORD=
UNLEASH_ADMIN_PASSWORD=
UNLEASH_BACKEND_API_TOKEN=
UNLEASH_ADMIN_API_TOKEN=
